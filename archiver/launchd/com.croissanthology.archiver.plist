<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.croissanthology.archiver</string>

  <!--
    Replace REPLACE_ME_REPO_PATH below with the absolute path to this repo
    on your MacBook (something like /Users/margot/code/croissanthology.github.io).
    The wrapper script lives there and sources your SMTP credentials.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>REPLACE_ME_REPO_PATH/archiver/launchd/maintain.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_ME_REPO_PATH</string>

  <!-- Run on the 1st of every month at 09:00 local time. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- If the Mac was asleep at the scheduled time, run as soon as it wakes. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>REPLACE_ME_REPO_PATH/archiver/launchd/maintain.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_ME_REPO_PATH/archiver/launchd/maintain.log</string>
</dict>
</plist>
