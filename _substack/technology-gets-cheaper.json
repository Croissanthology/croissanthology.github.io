 "cover_image": "https://substackcdn.com/image/fetch/$s_!-tkG!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F67a3dfc7-abb9-4cb8-995e-7c1e5ec2def6_2160x2160.png",
